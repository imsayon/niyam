{
  "name": "niyam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Examination operations and intelligent seating",
  "author": "Sayon",
  "main": "server/firebase.js",
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "scripts": {
    "dev": "npm --prefix next-app run dev",
    "build": "npm ci --prefix next-app --no-audit --no-fund && npm --prefix next-app run build",
    "build:firebase": "vite build",
    "emulators": "firebase emulators:start --project demo-niyam-local --only auth,firestore,functions,hosting",
    "seed:firebase": "node --env-file-if-exists=.env server/firebase-seed.js",
    "start": "npm --prefix next-app start",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --test",
    "test:firebase": "npm run build:firebase && firebase emulators:exec --project demo-niyam-local --only auth,firestore,functions,hosting 'FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 GCLOUD_PROJECT=demo-niyam-local node --test tests/firebase-emulator.test.js'",
    "desktop:win": "electron-builder --win nsis --x64",
    "desktop:linux": "electron-builder --linux AppImage --x64",
    "dev:legacy": "vite",
    "build:legacy": "vite build",
    "start:legacy": "node --env-file-if-exists=.env server/index.js"
  },
  "build": {
    "appId": "io.github.imsayon.niyam",
    "productName": "Niyam",
    "artifactName": "Niyam-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "app": "desktop"
    },
    "files": [
      "**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "desktop/icon.png",
      "artifactName": "Niyam-Setup-x64.exe"
    },
    "linux": {
      "target": "AppImage",
      "category": "Education",
      "icon": "desktop/icon.png",
      "artifactName": "Niyam-x86_64.AppImage"
    }
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@neon/auth": "0.8.2",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "firebase": "13.4.0",
    "firebase-admin": "14.5.1",
    "firebase-functions": "7.4.0",
    "lucide-react": "1.75.0",
    "nodemailer": "10.6.0",
    "pdfjs-dist": "6.5.438",
    "pdfkit": "0.17.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "firebase-tools": "15.37.0",
    "vite": "8.3.8"
  }
}
