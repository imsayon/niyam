{
  "name": "niyam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Examination operations and intelligent seating",
  "author": "Sayon",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --test",
    "desktop:win": "electron-builder --win nsis --x64",
    "desktop:linux": "electron-builder --linux AppImage --x64"
  },
  "build": {
    "appId": "io.github.imsayon.niyam",
    "productName": "Niyam",
    "artifactName": "Niyam-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "app": "desktop"
    },
    "files": [
      "**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "desktop/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "Education",
      "icon": "desktop/icon.png"
    }
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@neon/auth": "0.8.2",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "lucide-react": "1.75.0",
    "nodemailer": "10.6.0",
    "pdfjs-dist": "6.5.438",
    "pdfkit": "0.17.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "vite": "8.3.8"
  }
}
